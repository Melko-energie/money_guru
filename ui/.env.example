# Synchronisation entre appareils — facultative.
#
# Sans ces deux variables, l'application reste strictement locale : aucun
# compte, aucun envoi, tout vit dans le stockage du navigateur.
#
# Les deux valeurs se trouvent dans le projet Supabase, sous
# Settings → API. La clé « anon » est publique par nature : elle est faite
# pour être lue dans le navigateur, et la sécurité repose sur les règles
# de ligne posées par supabase/schema.sql — jamais sur son secret.
#
# Ne mettez JAMAIS la clé « service_role » ici : elle contourne ces règles.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique
